{
  "name": "film-x",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first collection of tools for film photography",
  "license": "GPL-3.0-only",
  "author": "HAIZAKURA",
  "repository": {
    "type": "git",
    "url": "https://github.com/haizakura/film-x.git"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint .",
    "format": "oxfmt --write app nuxt.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml README.md",
    "format:check": "oxfmt --check app nuxt.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml README.md",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@lucide/vue": "^1.38.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "nuxt": "^4.0.0",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "utif": "^3.1.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/utif": "^3.0.3",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vue-tsc": "latest"
  },
  "packageManager": "pnpm@11.0.0"
}
