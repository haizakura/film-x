{
  "name": "film-x",
  "version": "0.5.0",
  "private": true,
  "description": "A local-first collection of tools for film photography",
  "license": "Apache-2.0",
  "author": "HAIZAKURA",
  "repository": {
    "type": "git",
    "url": "https://github.com/haizakura/film-x.git"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "mcp:build": "pnpm --filter film-x-mcp build",
    "typecheck": "nuxt typecheck",
    "test:pwa": "node --test tests/pwa-update.test.mjs",
    "lint": "oxlint .",
    "format": "oxfmt --write app public/pwa-update-guard.js tests nuxt.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml README.md packages/mcp/src packages/mcp/package.json packages/mcp/vite.server.config.ts packages/mcp/tsconfig.server.json",
    "format:check": "oxfmt --check app public/pwa-update-guard.js tests nuxt.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml README.md packages/mcp/src packages/mcp/package.json packages/mcp/vite.server.config.ts packages/mcp/tsconfig.server.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm --filter film-x-mcp typecheck"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/syncopate": "^5.3.0",
    "@lucide/vue": "^1.55.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "nuxt": "^4.6.1",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "utif": "^3.1.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/utif": "^3.0.6",
    "@vite-pwa/nuxt": "^1.1.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.11.2"
}
